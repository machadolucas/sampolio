# Better Auth secret (signs session cookies) - generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here-generate-with-openssl-rand-base64-32

# Encryption key for the .enc files AND (via HKDF) the SQLCipher sampolio.db
# - generate with: openssl rand -hex 32. Keep a copy in a password manager.
ENCRYPTION_KEY=your-encryption-key-here-generate-with-openssl-rand-hex-32

# Public URL - REQUIRED in production (the app refuses to start auth without it).
# Better Auth base URL; its hostname is also the passkey RP ID, so changing the
# domain invalidates registered passkeys. Dev falls back to http://localhost:4999.
#AUTH_URL=https://sampolio.example.com

# Legacy (Auth.js); no longer read by the app, harmless if present.
#AUTH_TRUST_HOST=true

# Optional: Enable Banking (PSD2 AIS) read-only bank sync.
# Leave all three unset to disable the feature entirely (no network calls).
# The redirect URL must be publicly reachable and registered with Enable Banking.
#ENABLE_BANKING_APP_ID=00000000-0000-0000-0000-000000000000
#ENABLE_BANKING_REDIRECT_URL=https://sampolio.example.com/api/bank/callback
#ENABLE_BANKING_PRIVATE_KEY_FILE=/home/youruser/.sampolio/enable_banking_private_key.pem
