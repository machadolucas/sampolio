{
  "name": "sampolio",
  "version": "1.2.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev -p 3999",
    "dev:preview": "DEV_AUTH_BYPASS=machadolucas@me.com next dev -p 3999",
    "build": "npm run copy-themes && next build",
    "start": "next start",
    "lint": "eslint",
    "copy-themes": "mkdir -p public/themes && cp node_modules/primereact/resources/themes/mdc-dark-deeppurple/theme.css public/themes/mdc-dark-deeppurple.css && cp node_modules/primereact/resources/themes/mdc-light-deeppurple/theme.css public/themes/mdc-light-deeppurple.css",
    "postinstall": "npm run copy-themes",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "jose": "^6.2.3",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-auth": "5.0.0-beta.31",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.77.0",
    "react-icons": "^5.6.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
