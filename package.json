{
  "name": "sampolio",
  "version": "6.0.1",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4999",
    "dev:preview": "DEV_AUTH_BYPASS=you@example.com next dev -H 127.0.0.1 -p 4999",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:snapshot": "node scripts/db-snapshot.mjs",
    "test:e2e": "HEAVY_MIN_DISK_GB=40 HEAVY_ABORT_DISK_GB=40 \"$HOME/claude/scripts/heavy-job.sh\" playwright test",
    "build:synthetic": "HEAVY_MIN_DISK_GB=40 HEAVY_ABORT_DISK_GB=40 \"$HOME/claude/scripts/heavy-job.sh\" node scripts/browser-fixture.mjs build",
    "test:e2e:production": "SAMPOLIO_BROWSER_MODE=serve HEAVY_MIN_DISK_GB=40 HEAVY_ABORT_DISK_GB=40 \"$HOME/claude/scripts/heavy-job.sh\" playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/passkey": "1.7.12",
    "@daypicker/react": "10.0.2",
    "@hookform/resolvers": "^6.0.0",
    "@tanstack/react-table": "9.3.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.12",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@13.0.3",
    "chart.js": "^4.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "jose": "^6.2.13",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "playwright-core": "1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  }
}
